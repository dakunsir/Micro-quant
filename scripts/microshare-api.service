[Unit]
Description=Microshare read-only local data API
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/data/projects/microshare
ExecStart=/home/admin/miniconda3/bin/python3 main.py api start
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
